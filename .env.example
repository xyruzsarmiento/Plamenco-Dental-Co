# PUBLIC CLIENT CONFIGURATION - required for browser Supabase access.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DEPLOYMENT_ENV=development

# DEVELOPMENT ONLY - keeps legacy local staff-password fallback disabled unless explicitly enabled.
# Do not enable in production hosting.
VITE_ENABLE_LEGACY_LOCAL_AUTH=false

# SERVER SECRET - Supabase Edge Function runtime only. Do not expose in browser builds.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# PRODUCTION REQUIRED - public HTTPS URLs used by auth redirects, webhooks, and email links.
APP_URL=
SITE_URL=
PUBLIC_SITE_URL=

# OPTIONAL INTEGRATION / PRODUCTION REQUIRED IF EMAIL IS ENABLED - server-side only.
EMAIL_PROVIDER=
EMAIL_PROVIDER_ENDPOINT=
EMAIL_API_KEY=
EMAIL_FROM=

# OPTIONAL INTEGRATION / PRODUCTION REQUIRED IF SMS IS ENABLED - server-side only.
SMS_PROVIDER=
SMS_PROVIDER_ENDPOINT=
SMS_API_KEY=
SMS_SENDER_NAME=

# OPTIONAL INTEGRATION / PRODUCTION REQUIRED IF MESSENGER IS ENABLED - server-side only.
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=

# OPTIONAL INTEGRATION / PRODUCTION REQUIRED IF ONLINE PAYMENTS ARE ENABLED - server-side only.
PAYMENT_PROVIDER=
PAYMENT_ENVIRONMENT=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
